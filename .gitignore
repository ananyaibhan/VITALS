# ==============================================================================
# HEMO-PULSE MLOps • Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example

# ------------------------------------------------------------------------------
# 2. Machine Learning Model Artifacts
# ------------------------------------------------------------------------------
*.pkl
*.joblib
*.ubj
*.skops
*.h5
*.pb
*.onnx
*.pt
*.pth
**/models/*.pkl
**/models/*.joblib
**/models/*.ubj
**/models/*.skops
!**/models/.gitkeep

# ------------------------------------------------------------------------------
# 3. Datasets & Raw / Processed Data
# ------------------------------------------------------------------------------
**/data/raw/*.csv
**/data/processed/*.csv
*.csv.gz
*.parquet
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# ------------------------------------------------------------------------------
# 4. MLflow Experiments & Databases
# ------------------------------------------------------------------------------
mlruns/
**/mlruns/
mlflow.db
**/mlflow.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 5. Monitoring Reports & Generated Audits
# ------------------------------------------------------------------------------
**/monitoring/reports/*.html
**/monitoring/reports/*.json
!**/monitoring/reports/.gitkeep

# ------------------------------------------------------------------------------
# 6. Python Environment & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
pytest_debug.log

# ------------------------------------------------------------------------------
# 7. Frontend / Node.js
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
**/dist/
.vite/
**/dist-ssr/

# ------------------------------------------------------------------------------
# 8. OS & IDE Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp
*.swo
.project
.pydevproject
.settings/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# DVC local configs
.dvc/config.local
.dvc/tmp/
.dvc/cache/
