# ==============================================================================
# HEMO-PULSE MLOps • Environment Configuration Template
# Duplicate this file as '.env' and adjust variables for your environment.
# ==============================================================================

# --- Backend API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_TITLE="Blood Bank Optimizer & MLOps API"
API_VERSION="2.0.0"

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8000
PORT=5173

# --- MLflow Experiment Tracking ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_FORECASTING="Blood_Bank_Forecasting"
MLFLOW_EXPERIMENT_EXPIRY="Blood_Bank_Expiry_Risk"

# --- Storage & Model Artifact Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
MONITORING_REPORTS_DIR=monitoring/reports

# --- Optimization Cost Parameters ---
COST_SHORTAGE_PENALTY=100
COST_TRANSFER_PER_UNIT=5
COST_COLLECTION_PER_UNIT=10

# --- Logging & Security ---
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
